# Sangati API Production Environment Configuration Example
PROJECT_NAME="Sangati"
API_V1_STR="/api/v1"
ENVIRONMENT="production"

# PostgreSQL Database URL (Supabase PostgreSQL Connection String)
# Example: postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
DATABASE_URL="postgresql://user:password@localhost:5432/sangati_db"

# Supabase Configuration
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_JWT_SECRET="your-supabase-jwt-secret-from-dashboard"

# CORS Configuration (comma-separated origins for production)
ALLOWED_ORIGINS="http://localhost:3000,https://sangati.vercel.app"
FRONTEND_URL="https://sangati.vercel.app"
