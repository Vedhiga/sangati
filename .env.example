# ==========================================
# SideQuest Environment Variables Example
# ==========================================

# ------------------------------------------
# FRONTEND (Next.js)
# ------------------------------------------
# Supabase Project URL (from Supabase Dashboard -> Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Anon Public Key (safe for browser exposure)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Backend API base URL
NEXT_PUBLIC_API_URL=http://localhost:8000


# ------------------------------------------
# BACKEND (FastAPI)
# ------------------------------------------
# Database Connection String (from Supabase Dashboard -> Project Settings -> Database)
# e.g., postgresql://postgres.your-ref:your-password@aws-0-region.pooler.supabase.com:6543/postgres
DATABASE_URL=postgresql://postgres:your-db-password@db.your-project-id.supabase.co:5432/postgres

# Supabase URL for backend JWT validation & JWKS key fetching
SUPABASE_URL=https://your-project-id.supabase.co

# Supabase JWT Secret (from Supabase Dashboard -> Project Settings -> API -> JWT Secret)
# Used for HS256 validation if asymmetric JWKS is not configured
SUPABASE_JWT_SECRET=your-supabase-jwt-secret

# Allowed CORS Origins (comma-separated list)
ALLOWED_ORIGINS=http://localhost:3000

# Runtime environment (development / production)
ENVIRONMENT=development
